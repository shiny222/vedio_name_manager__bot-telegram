# Pin this to the version currently used by your existing n8n before migration.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_BIND_ADDRESS=0.0.0.0
N8N_PORT=5678
N8N_HOST=192.168.40.240

# Browser address of n8n on your LAN.
N8N_EDITOR_BASE_URL=http://192.168.40.240:5678/
# Local Telegram Bot API will call this address over the shared Docker network.
N8N_WEBHOOK_URL=http://n8n:5678/
N8N_SECURE_COOKIE=false

# Preserve the old key when migrating an existing n8n installation.
# For a brand-new instance: openssl rand -hex 32
N8N_ENCRYPTION_KEY=PUT_A_LONG_RANDOM_VALUE_HERE
