# Repository clone used as the Docker build context.
VIDEO_MANAGER_SOURCE_ROOT=__SOURCE_ROOT__
VIDEO_MANAGER_IMAGE_TAG=latest

# The current NAS media group is users (GID 100). This combination passed the
# mount permission model described in nas/README.md.
PUID=0
PGID=100

# Telegram bot token from BotFather. Keep secrets only in .env.
BOT_TOKEN=PUT_BOT_TOKEN_HERE

# Empty means every chat can use the bot. Example: -1001234567890,123456789
ALLOWED_CHAT_IDS=

# All six mounted Jellyfin libraries are available at the same time. Every
# Telegram chat chooses one from /libraries; that selection also changes mode.
LIBRARY_ANIMATION_SERIES_PATH=/media/animation-serise
LIBRARY_ANIMATION_SERIES_NAME=Animation Series
LIBRARY_ANIMATION_MOVIE_PATH=/media/animation-movie
LIBRARY_ANIMATION_MOVIE_NAME=Animation Movies
LIBRARY_VIDEO_SERIES_PATH=/media/video-serise
LIBRARY_VIDEO_SERIES_NAME=Video Series
LIBRARY_VIDEO_MOVIE_PATH=/media/video-movie
LIBRARY_VIDEO_MOVIE_NAME=Video Movies
LIBRARY_ANIME_SERIES_PATH=/media/anime-series
LIBRARY_ANIME_SERIES_NAME=Anime Series
LIBRARY_ANIME_MOVIE_PATH=/media/anime-movie
LIBRARY_ANIME_MOVIE_NAME=Anime Movies
DEFAULT_LIBRARY_KEY=animation_series

MOVIE_STAGING_PATH=/app/staging/movies
DATA_PATH=/app/data
LOGS_PATH=/app/logs

# Add a Jellyfin API key to enable scan/status commands. Other bot features
# continue to work when this is empty.
JELLYFIN_SERVER_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=
JELLYFIN_REQUEST_TIMEOUT_SECONDS=30
JELLYFIN_SCAN_POLL_INTERVAL_SECONDS=5
JELLYFIN_SCAN_MONITOR_TIMEOUT_SECONDS=3600
SCAN_AFTER_MOVIE_IMPORT=true
SCAN_AFTER_AI_SERIES_SORT=true

TELEGRAM_DOWNLOAD_READ_TIMEOUT_SECONDS=1800
MAX_PARALLEL_DOWNLOADS=1
CONFIRM_BEFORE_DOWNLOAD=true
ASK_BEFORE_OVERWRITE=true
DEFAULT_TARGET_FOLDER=
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mkv,.avi,.mov,.webm,.m4v
SORTER_TIMEOUT_SECONDS=1800
MOVIE_SORTER_TIMEOUT_SECONDS=1800
FUZZY_SEARCH_TIMEOUT_SECONDS=20
ANILIST_SEARCH_TIMEOUT_SECONDS=20

# AI filename identification. This must be the Webhook node's production URL,
# not the browser editor URL containing /workflow/ and projectId.
N8N_AGENT_ENABLED=false
N8N_AGENT_URL=http://n8n:5678/webhook/media-identify
# If Header Auth is enabled on the n8n Webhook, use this value for the
# X-Video-Manager-Secret credential in n8n.
N8N_AGENT_SECRET=
N8N_AGENT_TIMEOUT_SECONDS=45

# The Local Bot API data path must be the same host directory mounted by the
# telegram-bot-api container. Both containers use the identical target path.
TELEGRAM_BOT_API_DATA_PATH=__STACK_ROOT__/telegram-bot-api-compose/data

HOST_ANIMATION_MOVIE_PATH=/srv/dev-disk-by-uuid-e5048a2d-8521-41d1-8efc-880e999ecc6f/Archive/VIDEO_ARCHIVE/jellyfin/animation-movie
HOST_ANIMATION_SERIES_PATH=/srv/dev-disk-by-uuid-e5048a2d-8521-41d1-8efc-880e999ecc6f/Archive/VIDEO_ARCHIVE/jellyfin/animation-serise
HOST_VIDEO_MOVIE_PATH=/srv/dev-disk-by-uuid-e5048a2d-8521-41d1-8efc-880e999ecc6f/Archive/VIDEO_ARCHIVE/jellyfin/video-movie
HOST_VIDEO_SERIES_PATH=/srv/dev-disk-by-uuid-e5048a2d-8521-41d1-8efc-880e999ecc6f/Archive/VIDEO_ARCHIVE/jellyfin/video-serise
HOST_ANIME_MOVIE_PATH=/srv/dev-disk-by-uuid-e5048a2d-8521-41d1-8efc-880e999ecc6f/Archive/VIDEO_ARCHIVE/jellyfin/anime-movie
HOST_ANIME_SERIES_PATH=/srv/dev-disk-by-uuid-e5048a2d-8521-41d1-8efc-880e999ecc6f/Archive/VIDEO_ARCHIVE/jellyfin/anime-series
